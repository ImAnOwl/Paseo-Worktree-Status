{
  "name": "paseo-worktree-status",
  "version": "0.1.0",
  "private": true,
  "description": "Paseo plugin that shows the git state of each task's worktree at a glance",
  "keywords": [
    "git",
    "paseo",
    "paseo-plugin",
    "worktree"
  ],
  "license": "MIT",
  "author": "Oliver Czempas <oliver@czempas.de>",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "format:check:files": "oxfmt --check",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepare": "lefthook install --force"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.9.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "lefthook": "^2.1.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
